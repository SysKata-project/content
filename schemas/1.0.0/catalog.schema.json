{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/SysKata-project/content/schemas/1.0.0/catalog.schema.json",
  "title": "SysKata content catalog 1.0.0",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "bundle_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "entities": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "$ref": "#/$defs/journey"
          },
          {
            "$ref": "#/$defs/unit"
          },
          {
            "$ref": "#/$defs/lesson"
          },
          {
            "$ref": "#/$defs/skill"
          },
          {
            "$ref": "#/$defs/reference"
          },
          {
            "$ref": "#/$defs/single_choice"
          },
          {
            "$ref": "#/$defs/command_order"
          },
          {
            "$ref": "#/$defs/command_entry"
          },
          {
            "$ref": "#/$defs/lab_task"
          }
        ]
      },
      "minItems": 1,
      "uniqueItems": true
    }
  },
  "required": [
    "schema_version",
    "bundle_version",
    "entities"
  ],
  "additionalProperties": false,
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*([.-][a-z0-9]+)*$"
    },
    "source": {
      "type": "object",
      "properties": {
        "baseline": {
          "type": "string",
          "minLength": 1
        },
        "reviewed_on": {
          "type": "string",
          "format": "date"
        },
        "reference_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          },
          "minItems": 1,
          "uniqueItems": true
        }
      },
      "required": [
        "baseline",
        "reviewed_on",
        "reference_ids"
      ],
      "additionalProperties": false
    },
    "runtime": {
      "type": "object",
      "properties": {
        "product": {
          "const": "openshift"
        },
        "curriculum_version": {
          "const": "4.22"
        },
        "tested_versions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "requirements": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0,
          "uniqueItems": true
        }
      },
      "required": [
        "product",
        "curriculum_version",
        "tested_versions",
        "requirements"
      ],
      "additionalProperties": false
    },
    "option": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "text": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "id",
        "text"
      ],
      "additionalProperties": false
    },
    "feedback": {
      "type": "object",
      "properties": {
        "criterion_id": {
          "$ref": "#/$defs/id"
        },
        "misconception_code": {
          "$ref": "#/$defs/id"
        },
        "explanation": {
          "type": "string",
          "minLength": 1
        },
        "reference_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          },
          "minItems": 1,
          "uniqueItems": true
        }
      },
      "required": [
        "criterion_id",
        "misconception_code",
        "explanation",
        "reference_ids"
      ],
      "additionalProperties": false
    },
    "reference": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "reference"
        },
        "id": {
          "$ref": "#/$defs/id"
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://"
        },
        "baseline": {
          "type": "string",
          "minLength": 1
        },
        "reviewed_on": {
          "type": "string",
          "format": "date"
        }
      },
      "required": [
        "kind",
        "id",
        "revision",
        "title",
        "url",
        "baseline",
        "reviewed_on"
      ],
      "additionalProperties": false
    },
    "skill": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "skill"
        },
        "id": {
          "$ref": "#/$defs/id"
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "prerequisites": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "source": {
          "$ref": "#/$defs/source"
        }
      },
      "required": [
        "kind",
        "id",
        "revision",
        "title",
        "description",
        "prerequisites",
        "source"
      ],
      "additionalProperties": false
    },
    "journey": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "journey"
        },
        "id": {
          "$ref": "#/$defs/id"
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "locale": {
          "type": "string",
          "pattern": "^[a-z]{2}(-[A-Z]{2})?$"
        },
        "prerequisites": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "unit_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "source": {
          "$ref": "#/$defs/source"
        },
        "runtime": {
          "$ref": "#/$defs/runtime"
        }
      },
      "required": [
        "kind",
        "id",
        "revision",
        "title",
        "locale",
        "prerequisites",
        "unit_ids",
        "source",
        "runtime"
      ],
      "additionalProperties": false
    },
    "unit": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "unit"
        },
        "id": {
          "$ref": "#/$defs/id"
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "prerequisites": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "lesson_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "source": {
          "$ref": "#/$defs/source"
        }
      },
      "required": [
        "kind",
        "id",
        "revision",
        "title",
        "prerequisites",
        "lesson_ids",
        "source"
      ],
      "additionalProperties": false
    },
    "lesson": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "lesson"
        },
        "id": {
          "$ref": "#/$defs/id"
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "prerequisites": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "objectives": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "$ref": "#/$defs/id"
              },
              "description": {
                "type": "string",
                "minLength": 1
              },
              "skill_ids": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/id"
                },
                "minItems": 1,
                "uniqueItems": true
              }
            },
            "required": [
              "id",
              "description",
              "skill_ids"
            ],
            "additionalProperties": false
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "exercise_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "estimated_minutes": {
          "type": "integer",
          "minimum": 1
        },
        "explanation_markdown": {
          "type": "string",
          "minLength": 1
        },
        "review_prompt": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "$ref": "#/$defs/source"
        }
      },
      "required": [
        "kind",
        "id",
        "revision",
        "title",
        "prerequisites",
        "objectives",
        "exercise_ids",
        "estimated_minutes",
        "explanation_markdown",
        "review_prompt",
        "source"
      ],
      "additionalProperties": false
    },
    "single_choice": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "exercise"
        },
        "id": {
          "$ref": "#/$defs/id"
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "type": {
          "const": "single_choice"
        },
        "skill_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "objective_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "prompt": {
          "type": "string",
          "minLength": 1
        },
        "hints": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "$ref": "#/$defs/id"
              },
              "text": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "id",
              "text"
            ],
            "additionalProperties": false
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "source": {
          "$ref": "#/$defs/source"
        },
        "options": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/option"
          },
          "minItems": 2,
          "uniqueItems": true
        },
        "assessment": {
          "type": "object",
          "properties": {
            "evaluator": {
              "$ref": "#/$defs/id"
            },
            "evaluator_version": {
              "type": "integer",
              "minimum": 1
            },
            "completion_evidence": {
              "const": "correct-response"
            },
            "feedback": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/feedback"
              },
              "minItems": 1,
              "uniqueItems": true
            },
            "reveal_markdown": {
              "type": "string",
              "minLength": 1
            },
            "correct_option_id": {
              "$ref": "#/$defs/id"
            }
          },
          "required": [
            "evaluator",
            "evaluator_version",
            "completion_evidence",
            "feedback",
            "reveal_markdown",
            "correct_option_id"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "kind",
        "id",
        "revision",
        "type",
        "skill_ids",
        "objective_ids",
        "prompt",
        "hints",
        "source",
        "options",
        "assessment"
      ],
      "additionalProperties": false
    },
    "command_order": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "exercise"
        },
        "id": {
          "$ref": "#/$defs/id"
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "type": {
          "const": "command_order"
        },
        "skill_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "objective_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "prompt": {
          "type": "string",
          "minLength": 1
        },
        "hints": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "$ref": "#/$defs/id"
              },
              "text": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "id",
              "text"
            ],
            "additionalProperties": false
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "source": {
          "$ref": "#/$defs/source"
        },
        "steps": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/option"
          },
          "minItems": 2,
          "uniqueItems": true
        },
        "assessment": {
          "type": "object",
          "properties": {
            "evaluator": {
              "$ref": "#/$defs/id"
            },
            "evaluator_version": {
              "type": "integer",
              "minimum": 1
            },
            "completion_evidence": {
              "const": "correct-response"
            },
            "feedback": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/feedback"
              },
              "minItems": 1,
              "uniqueItems": true
            },
            "reveal_markdown": {
              "type": "string",
              "minLength": 1
            },
            "correct_order": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/id"
              },
              "minItems": 1,
              "uniqueItems": true
            }
          },
          "required": [
            "evaluator",
            "evaluator_version",
            "completion_evidence",
            "feedback",
            "reveal_markdown",
            "correct_order"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "kind",
        "id",
        "revision",
        "type",
        "skill_ids",
        "objective_ids",
        "prompt",
        "hints",
        "source",
        "steps",
        "assessment"
      ],
      "additionalProperties": false
    },
    "command_entry": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "exercise"
        },
        "id": {
          "$ref": "#/$defs/id"
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "type": {
          "const": "command_entry"
        },
        "skill_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "objective_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "prompt": {
          "type": "string",
          "minLength": 1
        },
        "hints": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "$ref": "#/$defs/id"
              },
              "text": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "id",
              "text"
            ],
            "additionalProperties": false
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "source": {
          "$ref": "#/$defs/source"
        },
        "assessment": {
          "type": "object",
          "properties": {
            "evaluator": {
              "$ref": "#/$defs/id"
            },
            "evaluator_version": {
              "type": "integer",
              "minimum": 1
            },
            "completion_evidence": {
              "const": "correct-response"
            },
            "feedback": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/feedback"
              },
              "minItems": 1,
              "uniqueItems": true
            },
            "reveal_markdown": {
              "type": "string",
              "minLength": 1
            },
            "normalization": {
              "const": "literal-command-v1"
            },
            "accepted_commands": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 1,
              "uniqueItems": true
            }
          },
          "required": [
            "evaluator",
            "evaluator_version",
            "completion_evidence",
            "feedback",
            "reveal_markdown",
            "normalization",
            "accepted_commands"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "kind",
        "id",
        "revision",
        "type",
        "skill_ids",
        "objective_ids",
        "prompt",
        "hints",
        "source",
        "assessment"
      ],
      "additionalProperties": false
    },
    "lab_task": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "exercise"
        },
        "id": {
          "$ref": "#/$defs/id"
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "type": {
          "const": "lab_task"
        },
        "skill_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "objective_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "prompt": {
          "type": "string",
          "minLength": 1
        },
        "hints": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "$ref": "#/$defs/id"
              },
              "text": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "id",
              "text"
            ],
            "additionalProperties": false
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "source": {
          "$ref": "#/$defs/source"
        },
        "environment_profile": {
          "$ref": "#/$defs/id"
        },
        "runtime": {
          "$ref": "#/$defs/runtime"
        },
        "reset_behavior": {
          "const": "new-generation"
        },
        "assessment": {
          "type": "object",
          "properties": {
            "evaluator": {
              "$ref": "#/$defs/id"
            },
            "evaluator_version": {
              "type": "integer",
              "minimum": 1
            },
            "completion_evidence": {
              "const": "trusted-lab-result"
            },
            "feedback": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/feedback"
              },
              "minItems": 1,
              "uniqueItems": true
            },
            "reveal_markdown": {
              "type": "string",
              "minLength": 1
            },
            "setup_profile": {
              "$ref": "#/$defs/id"
            },
            "checks": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "criterion_id": {
                    "$ref": "#/$defs/id"
                  },
                  "evaluator": {
                    "$ref": "#/$defs/id"
                  },
                  "evaluator_version": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "parameters": {
                    "type": "object",
                    "minProperties": 1
                  }
                },
                "required": [
                  "criterion_id",
                  "evaluator",
                  "evaluator_version",
                  "parameters"
                ],
                "additionalProperties": false
              },
              "minItems": 1,
              "uniqueItems": true
            }
          },
          "required": [
            "evaluator",
            "evaluator_version",
            "completion_evidence",
            "feedback",
            "reveal_markdown",
            "setup_profile",
            "checks"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "kind",
        "id",
        "revision",
        "type",
        "skill_ids",
        "objective_ids",
        "prompt",
        "hints",
        "source",
        "environment_profile",
        "runtime",
        "reset_behavior",
        "assessment"
      ],
      "additionalProperties": false
    }
  }
}
